# ========================================================
# SECURE FILE EXCHANGE PORTAL - ENVIRONMENT CONFIGURATION
# ========================================================

# Django Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-key-in-production-64chars!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Options: 'sqlite' or 'postgresql'
DB_ENGINE=sqlite
DB_NAME=secure_file_portal
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Master Key for Key Derivation (AES-256)
# Must be a 32-byte (64 hex characters or base64) secret
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ClamAV Malware Scanner Configuration
# Set CLAMAV_ENABLED=False to use the built-in development mock scanner (safe for dev)
CLAMAV_ENABLED=False
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL (for generating shareable ephemeral links)
FRONTEND_URL=http://localhost:5173
