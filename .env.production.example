# ==============================================================================
# SECURE FILE EXCHANGE - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy and adapt these values in your cloud platform dashboard (Render, Railway, etc.)
# NEVER commit raw production credentials, passwords, or secrets to Git!

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SECURITY
# ------------------------------------------------------------------------------
# Set DEBUG to False in production!
DEBUG=False

# Generate a strong 50+ character random string for production
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-at-least-50-characters-long

# Hostnames allowed to serve your backend. Comma-separated.
# Example: secure-file-backend.onrender.com,.onrender.com
ALLOWED_HOSTS=secure-file-backend.onrender.com,.onrender.com

# ------------------------------------------------------------------------------
# 2. HOSTED POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
# In Render, Railway, Neon, or Supabase, this is automatically provided:
DATABASE_URL=postgres://user:password@host:5432/secure_file_portal

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC MASTER KEY
# ------------------------------------------------------------------------------
# 32-byte secret (64 hexadecimal characters) used for AES-256 key management
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_ENCRYPTION_KEY=your-64-character-hex-master-encryption-key-here

# ------------------------------------------------------------------------------
# 4. PERSISTENT STORAGE VAULT
# ------------------------------------------------------------------------------
# On Render / Railway with persistent disk mounted at /var/data:
STORAGE_DIR=/var/data/storage

# ------------------------------------------------------------------------------
# 5. CORS & CSRF ORIGINS (CONNECT BACKEND TO FRONTEND)
# ------------------------------------------------------------------------------
# Exact HTTPS URL of your deployed React frontend.
# Do NOT include a trailing slash!
CORS_ALLOWED_ORIGINS=https://secure-file-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://secure-file-frontend.onrender.com

# ------------------------------------------------------------------------------
# 6. FRONTEND PUBLIC URL (FOR EPHEMERAL SHARING LINKS)
# ------------------------------------------------------------------------------
# Base URL used when backend creates full ephemeral links:
# e.g. https://secure-file-frontend.onrender.com/access?token=...
FRONTEND_URL=https://secure-file-frontend.onrender.com

# ------------------------------------------------------------------------------
# 7. MALWARE SCANNER
# ------------------------------------------------------------------------------
# Set to False to use the built-in development/demonstration mock scanner:
CLAMAV_ENABLED=False
# If a live ClamAV daemon is running in a sidecar or Docker container:
# CLAMAV_ENABLED=True
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# ------------------------------------------------------------------------------
# 8. FRONTEND ENVIRONMENT VARIABLE (Vite)
# ------------------------------------------------------------------------------
# Set in the Frontend service's Environment settings:
# VITE_API_BASE_URL=https://secure-file-backend.onrender.com
